{
  "name": "stems",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "desktop:dev": "pnpm --filter desktop desktop:dev",
    "desktop:build": "pnpm --filter desktop desktop:build"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
